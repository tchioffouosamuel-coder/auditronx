# Requis par le composant IDF managé arduino-esp32 (voir hardware/README.md §
# "Reconnaissance faciale embarquée") : sans ce réglage, la configure CMake
# échoue avec "esp32-arduino requires CONFIG_FREERTOS_HZ=1000 (currently 100)".
CONFIG_FREERTOS_HZ=1000

# Les headers ESP-IDF 6.0.1 utilisés par arduino-esp32 contiennent des
# initialisations partielles valides mais signalées par GCC. Ne pas convertir
# ces avertissements du framework en erreurs de compilation.
CONFIG_COMPILER_WARNINGS_AS_ERRORS=n

# Module 16 Mo (voir le profil board N16R8 dans platformio.ini) — sous
# framework=espidf, ce réglage ne se déduit PAS automatiquement de
# platformio.ini comme sous framework=arduino.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ESP32-S3 N16R8 : active la PSRAM octale externe utilisée par la caméra et
# les buffers de décodage ESP-DL.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SUPPORT=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_MEMMAP=y

# Table de partitions custom (voir partitions.csv) : le binaire (WiFi+BLE+
# SD_MMC+caméra+esp-dl/ESP-WHO) dépasse largement la table par défaut d'IDF.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Pile de la tâche loop() : la poignée de main TLS de mbedTLS (syncWithApi(),
# HTTPS vers l'API) combinée aux buffers JSON locaux dépasse la pile par
# défaut (8 Ko) — provoquait un débordement de pile ("Guru Meditation Error:
# Double exception", crash en boucle ~15s après boot, pile décodée via `pio
# device monitor --filter esp32_exception_decoder` jusqu'à ecp_drbg_seed/
# stack_check.c). Anciennement une build_flag `-D...` (platformio.ini) sous
# framework=arduino ; c'est ici un symbole Kconfig sous ce mode hybride
# espidf+arduino-esp32.
CONFIG_ARDUINO_LOOP_STACK_SIZE=16384

# NetworkClientSecure compiles the PSK TLS paths and requires the matching
# mbedTLS key-exchange modes when warnings are treated as errors.
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y

# Load ESP-DL face models from the SD card to avoid PlatformIO's generated
# .espdl.S path handling for flash-embedded model data.
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=n
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_SDCARD=y
CONFIG_HUMAN_FACE_FEAT_MODEL_IN_FLASH_RODATA=n
CONFIG_HUMAN_FACE_FEAT_MODEL_IN_SDCARD=y

# --- Bluetooth / NimBLE (serveur BLE local, transport téléphone<->borne) ---
# Requis pour que le backend BLE NimBLE fourni par arduino-esp32 compile et
# lie correctement sous ce mode hybride espidf+arduino-esp32.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED_DEFAULT=y

CONFIG_BT_NIMBLE_USE_ESP_TIMER=n

# Sélectionne la stack NimBLE plutôt que Bluedroid : les deux ne peuvent pas
# coexister et NimBLE conserve une empreinte adaptée à cette application.
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n