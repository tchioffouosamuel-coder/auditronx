# =============================================================================
# Auditron X — .env de PRODUCTION (plateforme multi-établissement)
#
# À copier sur le serveur sous le nom `.env`, puis renseigner les 4 valeurs
# marquées « À RENSEIGNER ». Ne jamais versionner le fichier rempli.
#
# Hébergement visé : mutualisé Hostinger (hPanel), un utilisateur MySQL par
# base, pas de droit CREATE DATABASE, pas de worker de file, pas de symlink.
# =============================================================================

APP_NAME="Auditron X"

# production, et debug coupé : une erreur 500 en mode debug affiche la trace
# complète, avec le contenu du .env — donc les accès aux bases de TOUS les
# établissements. C'est la différence la plus importante avec les anciennes
# instances, qui tournaient en APP_ENV=local / APP_DEBUG=true.
APP_ENV=production
APP_DEBUG=false

# À RENSEIGNER : php artisan key:generate (sur le serveur, après la copie)
APP_KEY=

# Doit correspondre EXACTEMENT à l'URL publique de l'API, `/public` compris
# s'il y figure. Un APP_URL faux ne casse pas les routes, mais fausse les URL
# générées : liens des photos de pointage, liens de téléchargement des
# firmwares servis aux bornes.
#
# Sans `/public` : la racine du sous-domaine pointe sur le dossier `public/` de
# l'application, ou un .htaccess y réécrit les requêtes (voir README).
APP_URL=https://api.auditronx.com

APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `debug` en production remplit le disque et journalise chaque requête SQL.
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Bases de données
# -----------------------------------------------------------------------------
# `central` est la connexion par défaut : hors contexte établissement,
# l'application ne voit que l'annuaire des abonnés. La base de chaque
# établissement est renseignée à l'exécution d'après la table
# `etablissements` (nom, utilisateur, mot de passe) — ne RIEN mettre ici pour
# les locataires.
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306

# À RENSEIGNER : base centrale, à créer depuis hPanel (préfixe imposé par
# l'hébergeur). Son utilisateur n'a besoin de droits que sur elle.
DB_CENTRAL_DATABASE=u133979320_central
DB_USERNAME=u133979320_central
DB_PASSWORD=Auditron2026

# -----------------------------------------------------------------------------
# Plateforme
# -----------------------------------------------------------------------------
AUDITRON_TENANT_HEADER=X-Tenant
AUDITRON_TENANT_FIELD=etablissement
AUDITRON_TENANT_DB_PREFIX=u133979320_

# URL unique : pas de sous-domaine par établissement.
AUDITRON_TENANT_SUBDOMAIN=false

# L'utilisateur MySQL de l'hébergement mutualisé n'a pas le droit
# CREATE DATABASE : la base d'un nouvel abonné se crée depuis hPanel, puis
# `etablissement:create --base-existante`.
AUDITRON_CREATE_DATABASE=false

# Liste publique des abonnés sur l'écran de connexion et d'activation.
AUDITRON_CATALOGUE_PUBLIC=true

# Documentation d'API sur /docs/api. Fermée par défaut hors environnement
# local : la page expose la liste complète des routes et de leurs paramètres.
AUDITRON_DOCS_PUBLIC=false

# À RENSEIGNER une fois pour toutes, AVANT la reprise des établissements :
#   php -r "echo bin2hex(random_bytes(32));"
# Le changer plus tard rendrait illisible tout l'index « téléphone →
# établissement » (fonction « code oublié ? »).
AUDITRON_ANNUAIRE=true
AUDITRON_ANNUAIRE_SALT=

# -----------------------------------------------------------------------------
# Sessions, cache, files
# -----------------------------------------------------------------------------
# L'API est sans état (jetons Sanctum). Le pilote `file` évite d'avoir à
# maintenir une table `sessions` dans la base centrale, qui n'en a pas.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache épinglé sur la base centrale : prévisible quel que soit
# l'établissement actif, les clés étant déjà préfixées par établissement
# (voir TenantManager).
CACHE_STORE=database
DB_CACHE_CONNECTION=central

# Pas de worker de file sur un hébergement mutualisé : en `database`, les jobs
# s'empileraient sans jamais être traités. `sync` les exécute dans la requête.
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Notifications push (FCM)
# -----------------------------------------------------------------------------
# Une seule application mobile, donc un seul projet Firebase pour tous les
# établissements. Déposer la clé de compte de service à ce chemin, hors du
# dossier public.
FIREBASE_CREDENTIALS=storage/app/private/firebase-service-account.json

# -----------------------------------------------------------------------------
# Courriel (non utilisé à ce jour : aucune notification par mail)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@auditronx.com"
MAIL_FROM_NAME="${APP_NAME}"
