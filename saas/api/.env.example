APP_NAME="Auditron X"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Douala

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------------------
# Bases de données — une base centrale + une base par établissement
#--------------------------------------------------------------------------
# `central` est la connexion par défaut : hors contexte établissement,
# l'application ne voit que l'annuaire des abonnés. La connexion `tenant`
# reçoit son nom de base à l'exécution (voir App\Tenancy\TenantManager) ;
# ne jamais y mettre de DB_DATABASE ici.
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CENTRAL_DATABASE=auditron_central
DB_USERNAME=root
DB_PASSWORD=

# Serveur distinct pour les bases des établissements (facultatif : par défaut,
# les mêmes hôte et identifiants que la base centrale).
# DB_TENANT_HOST=
# DB_TENANT_PORT=
# DB_TENANT_USERNAME=
# DB_TENANT_PASSWORD=

#--------------------------------------------------------------------------
# Plateforme multi-établissement
#--------------------------------------------------------------------------
# En-tête par lequel chaque client désigne son établissement (URL unique).
AUDITRON_TENANT_HEADER=X-Tenant
AUDITRON_TENANT_FIELD=etablissement
AUDITRON_TENANT_DB_PREFIX=auditron_

# Ouverture éventuelle de sous-domaines par établissement, plus tard.
AUDITRON_TENANT_SUBDOMAIN=false
# AUDITRON_TENANT_BASE_DOMAIN=auditronx.com

# Liste publique des abonnés sur l'écran de connexion / d'activation.
AUDITRON_CATALOGUE_PUBLIC=true

# Index « numéro de téléphone → établissement ». Le sel doit être défini une
# fois pour toutes : le changer rend tout l'index existant illisible.
AUDITRON_ANNUAIRE=true
AUDITRON_ANNUAIRE_SALT=

# Mettre à false si l'utilisateur SQL n'a pas le droit CREATE DATABASE
# (hébergement mutualisé) : créer alors la base à la main, puis
# `etablissement:create --base-existante`.
AUDITRON_CREATE_DATABASE=true

# Compte éditeur initial créé par PlatformSeeder.
AUDITRON_ADMIN_EMAIL=admin@auditronx.com
AUDITRON_ADMIN_PASSWORD=ChangeMe123!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Push notifications (FCM) — une seule app mobile, donc un seul projet
# Firebase pour tous les établissements. Clé de compte de service, jamais
# versionnée.
FIREBASE_CREDENTIALS=storage/app/private/firebase-service-account.json
